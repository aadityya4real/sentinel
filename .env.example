APP_NAME=Sentinel
APP_ENV=development
APP_PORT=8080

# Go reads these values from the process environment; it does not load this file automatically.
# Copy values into your shell/process environment. Docker Compose also reads a root .env file.

# Shared API bearer token for agent ingestion and protected server operations. Replace with a random 32+ character secret.
SENTINEL_API_TOKEN=replace-this-with-a-random-token-at-least-32-chars

# Browser origins allowed to call the API and open its WebSocket.
SENTINEL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Agent API base URL. The agent posts metrics to /api/v1/metrics and sends SENTINEL_API_TOKEN.
SENTINEL_API_URL=http://localhost:8080

# Local-only defaults for the Docker Compose development stack; replace for shared environments.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

LOG_LEVEL=debug

AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
